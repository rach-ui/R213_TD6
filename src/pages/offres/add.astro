---
import Layout from "../../layouts/Layout.astro";
import { addOffre } from "../../backend.mjs";

let result = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  result = await addOffre(formData);
}
---

<Layout titre="Ajouter une offre">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Ajouter une offre</h1>

    {
      result && (
        <div
          class={`p-4 rounded-md mb-6 ${result.success ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"}`}
        >
          {result.message}
        </div>
      )
    }

    <form
      method="POST"
      enctype="multipart/form-data"
      class="bg-white p-8 rounded-lg shadow-md flex flex-col gap-6"
    >
      <div class="flex flex-col gap-1">
        <label for="nomMaison" class="text-sm font-medium text-gray-700"
          >Nom de la maison</label
        >
        <input
          id="nomMaison"
          name="nomMaison"
          type="text"
          required
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="prix" class="text-sm font-medium text-gray-700"
          >Prix (€)</label
        >
        <input
          id="prix"
          name="prix"
          type="number"
          min="0"
          required
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="nbSdb" class="text-sm font-medium text-gray-700"
          >Nombre de salles de bain</label
        >
        <input
          id="nbSdb"
          name="nbSdb"
          type="number"
          min="0"
          required
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="nbChambres" class="text-sm font-medium text-gray-700"
          >Nombre de chambres</label
        >
        <input
          id="nbChambres"
          name="nbChambres"
          type="number"
          min="0"
          required
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="surface" class="text-sm font-medium text-gray-700"
          >Surface (m²)</label
        >
        <input
          id="surface"
          name="surface"
          type="number"
          min="0"
          required
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="images" class="text-sm font-medium text-gray-700"
          >Images</label
        >
        <input
          id="images"
          name="images"
          type="file"
          multiple
          accept="image/*"
          class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <button
        type="submit"
        class="bg-blue-700 text-white py-3 rounded-md font-semibold hover:bg-blue-800 transition-colors"
      >
        Ajouter l'offre
      </button>
    </form>
  </div>
</Layout>
