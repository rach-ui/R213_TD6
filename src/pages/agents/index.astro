---
import Layout from '../../layouts/Layout.astro';
import { getAgents } from '../../backend.mjs';

const agents = await getAgents();
---

<Layout titre="Agents">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Nos Agents</h1>

  {agents.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {agents.map(agent => (
        <div class="bg-white rounded-lg shadow-md p-6 flex flex-col gap-3">
          <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 text-2xl font-bold">
            {agent.prenom?.charAt(0)}{agent.nom?.charAt(0)}
          </div>
          <div>
            <h2 class="text-xl font-semibold text-gray-800">{agent.prenom} {agent.nom}</h2>
            <p class="text-gray-500 text-sm">{agent.email}</p>
          </div>
          <a
            href={`/agents/${agent.id}`}
            class="mt-auto inline-block text-center bg-blue-700 text-white py-2 px-4 rounded-md hover:bg-blue-800 transition-colors text-sm font-medium"
          >
            Voir ses offres
          </a>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-500 py-16">Aucun agent disponible.</p>
  )}
</Layout>
