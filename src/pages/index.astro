---
import Layout from '../layouts/Layout.astro';
---

<Layout titre="Accueil">
  <div class="text-center py-16">
    <h1 class="text-5xl font-bold text-blue-700 mb-4">Bienvenue sur ImmoPlus</h1>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">
      Trouvez la maison de vos rêves parmi nos meilleures offres immobilières.
    </p>
    <a href="/offres" class="inline-block bg-blue-700 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-blue-800 transition-colors">
      Voir les offres
    </a>
  </div>
</Layout>
