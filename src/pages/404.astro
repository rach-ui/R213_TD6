---
import Layout from "../layouts/Layout.astro";
---

<Layout titre="Page introuvable">
    <div class="text-center py-24">
        <p class="text-8xl font-bold text-blue-200 mb-4">404</p>
        <h1 class="text-3xl font-bold text-gray-800 mb-4">Page introuvable</h1>
        <p class="text-gray-500 mb-8">
            La page que vous cherchez n'existe pas ou a été déplacée.
        </p>
        <a
            href="/"
            class="inline-block bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors"
        >
            Retour à l'accueil
        </a>
    </div>
</Layout>
